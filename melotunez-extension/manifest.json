{
  "manifest_version": 3,
  "name": "MeloTunez",
  "version": "0.1.0",
  "description": "Music discovery and AI build search — keys stay local; music via your Express API.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://openrouter.ai/*",
    "https://api.groq.com/*",
    "https://api.together.xyz/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open MeloTunez",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_page": "options/index.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
