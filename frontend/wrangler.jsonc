{
  // Assets-only Worker: serves the Hermes Studio static dashboard on Cloudflare.
  // Deploy: npm run deploy
  // Custom domain: add routes below (domain must already be on Cloudflare DNS), then redeploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cavernwolf-hermes-studio",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
  // Uncomment and set your domain(s) after they are active zones in Cloudflare:
  // "routes": [
  //   { "pattern": "example.com", "custom_domain": true },
  //   { "pattern": "www.example.com", "custom_domain": true }
  // ]
}
