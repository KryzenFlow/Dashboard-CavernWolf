# === Hermes Studio ===
HERMES_MOCK=0
HERMES_HOME=/data/hermes
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# public = customer-facing (whitelist CLI, no agent stack API)
# internal = your private Agent Ops / full stack (required for ops_dashboard on :3001)
STUDIO_MODE=internal
AGENT_STACK_ENABLED=1
# Set to 1 only when STUDIO_MODE=internal and you want full AI memory pipeline
AGENT_STACK_USE_AI=0

# === Hermes bridge (Studio deploy — no AI, no tokens by default) ===
HERMES_CLI_BRIDGE=claw
DEPLOY_PROFILE=static-export
DEPLOY_PROFILES_PATH=/shared/workflows/deploy-profiles.yaml
BLEED_MANIFEST_PATH=/shared/workflows/bleed-manifest.yaml
AGENT_REGISTRY_PATH=/shared/agents/registry.yaml
# Switch vertical without code: doctors | saas | auto_repair | real-estate | local-services
ACTIVE_BLEED=doctors

# Agent research queue (SQLite on /data — point second machine at same volume or API)
RESEARCH_DB_URL=sqlite:////data/research.db

# Blog / webpage drafts (OneDrive-synced via scripts/setup_onedrive_data.ps1)
CONTENT_DB_URL=sqlite:////data/content.db

# === LLM ===
LLM_PROVIDER=mock
LLAMA_URL=http://llama-service:8080
LLAMA_MODEL=llama-7b.ggmlv3.q4_0.bin
OLLAMA_URL=http://ollama:11434
OPENAI_API_BASE=
OPENAI_API_KEY=

# === Memory ===
MEMORY_DB_URL=sqlite:////data/memory.db
REDIS_URL=redis://redis:6379/0
CHROMA_URL=http://chroma:8000
STM_TTL_SECONDS=3600
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LTM_ENABLED=1

# === Agent Claw ===
CLAW_URL=http://agent-claw:9000
BACKEND_URL=http://backend:8000
TEMPLATES_DIR=/templates
DEV_TOOLS_WORKSPACE=/shared/workflows

# === Git (Docker) ===
GIT_REPO_ROOT=/repo
GITHUB_TOKEN=
GITHUB_REPOSITORY=KryzenFlow/Dashboard-CavernWolf
GIT_AUTHOR_NAME=Agent Claw
GIT_AUTHOR_EMAIL=claw@hermes.local

# === CI/CD webhooks (optional) ===
CI_WEBHOOK_TOKEN=

# === Optional hosting (only when using railway / azure-static profile) ===
RAILWAY_TOKEN=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=

# === Optional SMS ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
