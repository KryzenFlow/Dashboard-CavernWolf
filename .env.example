# Not for production secrets. Use Bitwarden (BW_SESSION) via wsl_backend.
# See DOCTOR.md. Empty / mock / dev-change-me values refuse to start.

# Non-secret service discovery (compose/WSL DNS)
CLAW_URL=http://claw-opus:9000
HERMES_URL=http://hermes:8000
CORS_ORIGINS=http://localhost:3000
TS_HOSTNAME=hermes-studio
CLAW_DAILY_REBUILD_HOUR_UTC=4

# Set by: export BW_SESSION=$(bw unlock --raw)
# Then: python3 -m wsl_backend.main  (pulls the items below from the vault)
# BW_SESSION=
# Vault items: hermes-supervisor-hmac, openclaw-gateway-url,
#              openclaw-gateway-token, tailscale-authkey
